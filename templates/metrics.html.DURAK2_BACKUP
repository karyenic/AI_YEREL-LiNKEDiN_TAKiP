{% extends "base.html" %}

{% block title %}Raporlama{% endblock %}

{% block content %}

<section class="panel">

  <div class="page-title-row">
    <div>
      <h2>📈 Raporlama ve Günlük Çalışma Merkezi</h2>
      <div class="muted">
        Aday durumu, günlük gelişmeler, hatırlatmalar ve AI destekli öneriler.
      </div>
    </div>
  </div>

  <div id="metrik-kutulari" class="metric-grid"></div>

  <div id="oranlar" class="muted oranlar"></div>

</section>


<section class="report-dashboard">

  <div class="panel report-card report-reminders">

    <div class="report-card-header">
      <h3>🔔 Hatırlatmalar</h3>
      <span class="report-badge">BUGÜN</span>
    </div>

    <div id="hatirlatmalar-listesi" class="report-list">

      <div class="report-empty">
        Şimdilik kayıtlı hatırlatma yok.
      </div>

    </div>

  </div>


  <div class="panel report-card report-journal">

    <div class="report-card-header">
      <h3>📓 Günlük Gelişmeler</h3>
      <span class="report-badge">GÜNLÜK</span>
    </div>

    <div class="journal-entry">

      <textarea
        id="gunluk-not"
        placeholder="Bugünkü gelişmeyi yazın...

Örneğin:
Cengiz ile görüşüldü.
Mehmet cuma günü tekrar aranacak.
Ayşe toplantıya olumlu yaklaştı."></textarea>

      <div class="journal-actions">

        <button
          class="btn-secondary"
          onclick="gunlukNotTemizle()">
          Temizle
        </button>

        <button
          class="btn-gonder"
          onclick="gunlukNotKaydet()">
          📓 Notu Kaydet
        </button>

      </div>

    </div>

    <div id="gunluk-not-durum" class="muted"></div>

  </div>


  <div class="panel report-card report-ai">

    <div class="report-card-header">

      <h3>🧠 AI Önerileri</h3>

      <button
        class="btn-ai-oner"
        onclick="aiOneriHazirla()">
        🔄 Güncelle
      </button>

    </div>

    <div id="ai-onerileri" class="ai-advice">

      <div class="ai-placeholder">

        <div class="ai-icon">🧠</div>

        <div>
          <strong>AI çalışma önerileri</strong>
          <p>
            Günlük gelişmeler ve aday geçmişi veri omurgasına
            bağlandığında burada takip edilmesi gereken kişiler,
            geciken görüşmeler ve olası sonraki adımlar gösterilecek.
          </p>
        </div>

      </div>

    </div>

  </div>


  <div class="panel report-card report-timeline">

    <div class="report-card-header">

      <h3>🕘 Son Gelişmeler</h3>

    </div>

    <div id="son-gelismeler" class="report-list">

      <div class="report-empty">
        Yeni veri omurgası devreye alındığında aday olay geçmişi
        burada kronolojik olarak gösterilecek.
      </div>

    </div>

  </div>

</section>

{% endblock %}
